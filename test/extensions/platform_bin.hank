() {
  log_print("Extension: Platform (Binary Module)")

  // Bitwise Logic
  // 10 (1010) AND 12 (1100) = 8 (1000)
  ? (math_eq(bin_and(10, 12), 8)) { log_print("bin_and: OK") }
  
  // 10 (1010) OR 12 (1100) = 14 (1110)
  ? (math_eq(bin_or(10, 12), 14)) { log_print("bin_or: OK") }
  
  // 10 (1010) XOR 12 (1100) = 6 (0110)
  ? (math_eq(bin_xor(10, 12), 6)) { log_print("bin_xor: OK") }
  
  // not(0) = -1 (in 64-bit signed)
  ? (math_eq(bin_not(0), -1)) { log_print("bin_not: OK") }

  // Shifts
  // 1 << 4 = 16
  ? (math_eq(bin_shiftL(1, 4), 16)) { log_print("bin_shiftL: OK") }
  
  // 16 >> 2 = 4
  ? (math_eq(bin_shiftR(16, 2), 4)) { log_print("bin_shiftR: OK") }
  
  // -1 >> 1 = -1 (sign-propagating)
  ? (math_eq(bin_shiftR(-1, 1), -1)) { log_print("bin_shiftR (neg): OK") }

  // Boundary Tests (53-bit Safe Integer Quirk)
  // Max Safe: 9007199254740991
  ? (math_eq(bin_and(9007199254740991, 1), 1)) { log_print("bin_and (max safe): OK") }
  
  // Error Verification (Out of Bounds)
  ? (bin_and(9007199254740992, 1)) {
    log_error("FAIL: Should have thrown out of bounds")
  } ~ (err) {
    log_print("bin_and (out of bounds): Caught OK")
  }

  ? (bin_shiftL(1, 54)) {
    log_error("FAIL: Should have thrown out of bounds (result)")
  } ~ (err) {
    log_print("bin_shiftL (out of bounds): Caught OK")
  }

  log_print("Platform extension pass")
}
