() {
  log_print("14 Hank SYSLIB Verification")

  // OS Module
  type = os_type()
  log_print(str_format("OS Type: %1", type))
  ? (logic_or(math_eq(type, "darwin"), math_eq(type, "linux"), math_eq(type, "windows"), math_eq(type, "bsd"))) {
    log_print("os_type(): OK")
  }
  
  // Advanced OS Stats
  mem = os_memory()
  ? (math_gt(map_get(mem, "total"), 0)) { log_print("os_memory(): OK") }
  cpu = os_cpu()
  ? (logic_or(math_gt(cpu, 0), math_eq(cpu, 0))) { log_print("os_cpu(): OK") }

  // Host Module
  cwd = host_cwd()
  log_print(str_format("Current Dir: %1", cwd))
  ? (cwd) { log_print("host_cwd(): OK") }
  
  is_root = host_isRoot()
  log_print(str_format("Is Root: %1", is_root))

  // Signal Module
  runtime_signal("Testing Signal")
  log_print("runtime_signal(): OK")

  // FS Module
  test_file = "hank_test.txt"
  fs_write(test_file, "HAL was here")
  ? (fs_exists(test_file)) {
    s = fs_stat(test_file)
    ? (math_eq(map_get(s, "size"), 12)) {
        log_print("fs_stat size (number): OK")
    }
    ? (map_get(s, "mtime")) {
        log_print("fs_stat mtime: OK")
    }
    content = fs_read(test_file)
    ? (math_eq(content, "HAL was here")) {
        log_print("fs_write/read: OK")
    }
  }

  res = proc_run("echo", ["hello-from-proc"])
  ? (math_eq(map_get(res, "code"), 0)) {
    ? (regex_match(map_get(res, "stdout"), "hello-from-proc")) {
        log_print("proc_run: OK")
    }
  }

  // Cleanup
  fs_deleteFile(test_file)
  ? (!fs_exists(test_file)) { log_print("fs_delete: OK") }

  log_print("14 Pass")
}
