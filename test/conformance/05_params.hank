() {
  log_print("05 Task Parameters")

  // 1. Required
  req = (a) { ^ a }
  ? req(1) { log_print("Required parameter: OK") }

  // 2. Optional
  opt = (?a) { ^ a }
  ? !opt() { log_print("Optional parameter (omitted): OK") }
  ? opt(1) { log_print("Optional parameter (provided): OK") }

  // 3. Default
  def = (a = 100) { ^ a }
  val = def()
  ? math_eq(val, 100) { log_print("Default parameter (omitted): OK") }
  ? math_eq(def(200), 200) { log_print("Default parameter (provided): OK") }

  // 4. Sequential Referencing
  ref = (a, b = a) { ^ b }
  ? math_eq(ref(50), 50) { log_print("Default parameter forward referencing: OK") }

  // 5. Arity Enforcement
  ? 1 {
    def(1, 2) // Too many args
    log_print("Arity Failure: Host did not throw error")
  } ~ (err) {
    log_print(str_format("Arity Enforcement: OK (%1)", err))
  }

  log_print("05 Pass")
}
