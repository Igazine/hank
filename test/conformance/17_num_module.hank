() {
  log_print("17 Number Conversion Module")

  // Parsing & Auto-detection
  ? math_eq(num_parse("255"), 255) { log_print("num_parse (dec): OK") }
  ? math_eq(num_parse("0xFF"), 255) { log_print("num_parse (hex): OK") }
  ? math_eq(num_parse("0b1010"), 10) { log_print("num_parse (bin): OK") }
  ? math_eq(num_parse("0o77"), 63) { log_print("num_parse (oct): OK") }

  // Custom Radix (up to 36)
  ? math_eq(num_parse("zz", 36), 1295) { log_print("num_parse (base36): OK") }
  ? math_eq(num_format(1295, 36), "zz") { log_print("num_format (base36): OK") }
  ? math_eq(num_format(255, 16), "ff") { log_print("num_format (hex): OK") }

  log_print("17 Pass")
}
