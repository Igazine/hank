() {
  log.print("17 Number Conversion Module")

  // Parsing & Auto-detection
  ? math.eq(num.parse("255"), 255) { log.print("num.parse (dec): OK") }
  ? math.eq(num.parse("0xFF"), 255) { log.print("num.parse (hex): OK") }
  ? math.eq(num.parse("0b1010"), 10) { log.print("num.parse (bin): OK") }
  ? math.eq(num.parse("0o77"), 63) { log.print("num.parse (oct): OK") }

  // Custom Radix (up to 36)
  ? math.eq(num.parse("zz", 36), 1295) { log.print("num.parse (base36): OK") }
  ? math.eq(num.format(1295, 36), "zz") { log.print("num.format (base36): OK") }
  ? math.eq(num.format(255, 16), "ff") { log.print("num.format (hex): OK") }

  log.print("17 Pass")
}
