@ "resources/sum"
@ "resources/recursive_a"

() {
  log.print("06 Parse-Time Macros (@)")

  // Shorthand and derivation
  ? math.eq(sum(10, 20), 30) { log.print("Macro inclusion & task derivation: OK") }

  // Recursion
  recursive_a("hello from recursion")
  log.print("Recursive macro expansion: OK")

  // Evaluation result (Void)
  // We test that a task concluding with a macro call returns Void.
  test_void = () {
    @ "resources/sum"
  }
  res = test_void()
  ? !res { log.print("MacroInclude (via Task result) evaluates to Void: OK") }

  log.print("06 Pass")
}
