() {
  log_print("13 Logic Module (and, or)")

  // logic_and tests
  ? math_eq(logic_and(1, 2, 3), 3) { log_print("logic_and(all truthy): OK") }
  ? !logic_and(1, Void, 3) { log_print("logic_and(contains Void): OK") }
  ? math_eq(logic_and("hello"), "hello") { log_print("logic_and(single arg): OK") }
  ? !logic_and() { log_print("logic_and(empty): OK") }

  // logic_or tests
  ? math_eq(logic_or(Void, 0, 1), 0) { log_print("logic_or(finds first truthy, even 0): OK") }
  ? math_eq(logic_or("a", "b"), "a") { log_print("logic_or(first truthy): OK") }
  ? !logic_or(Void, Void) { log_print("logic_or(all Void): OK") }
  ? !logic_or() { log_print("logic_or(empty): OK") }

  log_print("13 Pass")
}
