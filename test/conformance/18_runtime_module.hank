() {
  log.print("18 Runtime Module")

  // elapsedTime
  t1 = runtime.elapsedTime()
  ? (math.gt(t1, 0)) { log.print("runtime.elapsedTime: OK") }

  // while loop
  // Count from 0 to 5 using array length to mutate state across closures
  counter_arr = []
  cond = () { math.lt(arr.length(counter_arr), 5) }
  body = () {
    arr.push(counter_arr, 1)
  }

  runtime.while(cond, body)
  ? (math.eq(arr.length(counter_arr), 5)) { log.print("runtime.while: OK") }

  log.print("18 Pass")
}
