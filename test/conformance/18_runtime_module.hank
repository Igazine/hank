() {
  log.print("18 Loop & Runtime Module")

  // elapsedTime
  t1 = runtime.elapsedTime()
  ? (math.gt(t1, 0)) { log.print("runtime.elapsedTime: OK") }

  // while loop
  // Count from 0 to 5 using array length to mutate state across closures
  counter_arr = []
  cond = () { math.lt(arr.length(counter_arr), 5) }
  body = () {
    arr.push(counter_arr, 1)
  }

  loop.while(cond, body)
  ? (math.eq(arr.length(counter_arr), 5)) { log.print("loop.while: OK") }

  // break loop
  counter_arr2 = []
  cond2 = () { 1 } // Infinite loop
  body2 = () {
    ? (math.eq(arr.length(counter_arr2), 3)) {
        loop.break()
    }
    arr.push(counter_arr2, 1)
  }
  loop.while(cond2, body2)
  ? (math.eq(arr.length(counter_arr2), 3)) { log.print("loop.break: OK") }

  log.print("18 Pass")
}
