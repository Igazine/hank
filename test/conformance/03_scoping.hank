() {
  log_print("03 Scoping & Core Protection")

  v = "outer"
  // Using an immediately invoked task to create a lexical scope
  (x) {
    v = "inner"
    log_print(str_format("Nested Write (Lexical): %1", v))
  }(1)
  ? regex_match(v, "inner") { log_print("Outer scope reflects nested write: OK") }

  // Core Shadowing
  log_shadow = "not a task"
  ? regex_match(log_shadow, "not a task") { #log_print("Core task shadowed locally: OK") }

  // Core Guarding
  #log_print("Core guard sigil (#) bypasses shadowing: OK")

  log_print("03 Pass")
}
