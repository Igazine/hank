() {
  // String equality
  log_print("Test 1: logic_eq(\"abc\", \"abc\")")
  ? (logic_eq("abc", "abc")) {
    log_print("PASS")
  } : {
    log_error("FAIL")
  }

  log_print("Test 2: logic_eq(\"abc\", \"def\")")
  ? (logic_eq("abc", "def")) {
    log_error("FAIL")
  } : {
    log_print("PASS")
  }

  // Number equality
  log_print("Test 3: logic_eq(123, 123)")
  ? (logic_eq(123, 123)) {
    log_print("PASS")
  } : {
    log_error("FAIL")
  }

  // Deep equality (Array)
  log_print("Test 4: logic_eq([1, 2], [1, 2])")
  ? (logic_eq([1, 2], [1, 2])) {
    log_print("PASS")
  } : {
    log_error("FAIL")
  }

  // Deep equality (Map)
  log_print("Test 5: logic_eq([ \"x\": 1 ], [ \"x\": 1 ])")
  ? (logic_eq([ "x": 1 ], [ "x": 1 ])) {
    log_print("PASS")
  } : {
    log_error("FAIL")
  }

  // Backward compatibility (math_eq)
  log_print("Test 6: math_eq(\"xyz\", \"xyz\")")
  ? (math_eq("xyz", "xyz")) {
    log_print("PASS")
  } : {
    log_error("FAIL")
  }
}
