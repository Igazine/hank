() {
  log_print("02 Unified Gates & Negation")

  // Truthiness
  ? 1 { log_print("1 is Truthy: OK") } : { log_print("FAILED") }
  ? 0 { log_print("0 is Truthy: OK") } : { log_print("FAILED") }
  ? "" { log_print("Empty string is Truthy: OK") } : { log_print("FAILED") }
  ? [] { log_print("Empty array is Truthy: OK") } : { log_print("FAILED") }

  // Falsiness
  ? missing_var { log_print("FAILED") } : { log_print("Void is Falsy: OK") }

  // Negation
  ? !missing_var { log_print("!Void is Truthy: OK") }
  ? !1 { log_print("FAILED") } : { log_print("!1 is Falsy: OK") }

  // Rescue
  ? 1 {
    non_existent_task()
  } ~ (err) {
    log_print(str_format("Rescue caught error: %1", err))
    log_print("Rescue: OK")
  }

  // Full Chain
  ? missing_var {
    log_print("FAILED")
  } : {
    log_print("Fallback executed: OK")
  } ~ (err) {
    log_print("FAILED (Rescue should not trigger for fallback)")
  }

  log_print("02 Pass")
}
