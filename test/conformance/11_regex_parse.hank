() {
  log_print("11 Dynamic Regex & Opaque Type")

  // 1. Opaque Creation (Dynamic Regex Parse)
  pattern = "hal"
  re1 = regex_parse(pattern, "i")
  
  // 2. Opaque Semantics (Truthy & Non-Empty)
  ? re1 { log_print("Opaque handle creation: OK") }

  // 3. Regex Matching (using Opaque)
  ? regex_match("HYBRID AUTOMATION LANGUAGE (HAL)", re1) { log_print("Regex match with Opaque: OK") }

  // 4. Negative Match
  ? !regex_match("No match here", re1) { log_print("Negative Match: OK") }

  // 5. String Pattern Fallback (Implicit Regex)
  ? regex_match("foobar", "foo") { log_print("String Pattern Fallback: OK") }

  // 6. Opaque Coercion (Debugging)
  // Note: Host implementations are encouraged to label this [Opaque:RegExp]
  s = str_format("%1", re1)
  ? regex_match(s, "Opaque") { log_print("Opaque string coercion: OK") }

  log_print("11 Pass")
}
