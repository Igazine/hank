() {
  log.print("02 Unified Gates & Negation")

  // Truthiness
  ? (1) { log.print("1 is Truthy: OK") } : { log.print("FAILED") }
  ? (0) { log.print("0 is Truthy: OK") } : { log.print("FAILED") }
  ? ("") { log.print("Empty string is Truthy: OK") } : { log.print("FAILED") }
  ? ([]) { log.print("Empty array is Truthy: OK") } : { log.print("FAILED") }

  // Falsiness
  ? (missing_var) { log.print("FAILED") } : { log.print("Void is Falsy: OK") }

  // Negation
  ? (!missing_var) { log.print("!Void is Truthy: OK") }
  ? (!1) { log.print("FAILED") } : { log.print("!1 is Falsy: OK") }

  // Rescue
  ? (1) {
    non_existent_task()
  } ~ (err) {
    log.print(str.format("Rescue caught error: %1", err))
    log.print("Rescue: OK")
  }

  // Full Chain
  ? (missing_var) {
    log.print("FAILED")
  } : {
    log.print("Fallback executed: OK")
  } ~ (err) {
    log.print("FAILED (Rescue should not trigger for fallback)")
  }

  log.print("02 Pass")
}
