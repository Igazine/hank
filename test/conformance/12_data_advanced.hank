() {
  log_print("12 Advanced Data Modules")

  // 1. map_get (Dynamic Access)
  o = [ "name": "tamas", "age": 30 ]
  key = "name"
  ? (math_eq(map_get(o, key), "tamas")) { log_print("map_get: OK") }
  ? (!map_get(o, "missing")) { log_print("map_get (missing): OK") }

  // 2. arr_each (Snapshot Iteration)
  items = [1, 2, 3]
  log_print("Starting each with mutation...")
  arr_each(items, (item, idx) {
    ? (math_eq(item, 1)) {
      arr_push(items, 4) // Mutate original array
    }
    log_print(str_format("Item %1: %2", idx, item))
  })
  // items should now be [1, 2, 3, 4] but only 3 iterations should have occurred.
  ? (math_eq(arr_length(items), 4)) { log_print("Original array mutated: OK") }

  // 3. arr_each (Local Param Scope)
  // We use ?idx to satisfy strict arity enforcement
  arr_each([10], (val, ?idx) {
    val = 20 // Local reassignment
  })
  // 4. JSON & Opaque State (Non-serializability)
  re = regex_parse("test")
  json_res = json_stringify([ "key": re ])
  // Should either evaluate to Void or the object without the opaque key
  ? (!json_res) {
    log_print("Opaque non-serializability (Void): OK")
  } : {
    // If it returns a string, it must not contain the opaque reference in a way that breaks parity
    ? (!regex_match(json_res, "test")) {
        log_print("Opaque non-serializability (Omitted): OK")
    }
  }

  log_print("12 Pass")
}
