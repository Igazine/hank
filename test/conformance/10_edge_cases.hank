() {
  log_print("10 Edge Cases & Stress")

  // 1. String Stress
  s1 = "  "
  s2 = ""
  ? math_gt(str_length(s1), 0) { log_print("Whitespace string length: OK") }
  ? !str_length(s2) { log_print("Empty string length: OK") }

  // 2. Omitted Optional Args Out of Order
  test_args = (?a, ?b, c = 100) {
    ^ [a, b, c]
  }
  // c should default, a and b should be Void
  res = test_args()
  ? !arr_get(res, 0) { log_print("Omitted Optional A: OK") }
  ? math_eq(arr_get(res, 2), 100) { log_print("Default Parameter C: OK") }

  // 3. Block Result Stress (using IIFE)
  res3 = () {
    x = 10
    y = 20
    ^ math_add(x, y)
  }()
  ? math_eq(res3, 30) { log_print("IIFE execution result: OK") }

  // 4. Nested Task Calls as Arguments
  log_task = (val) { ^ val }
  res4 = log_task(log_task(log_task("recursive")))
  ? math_eq(res4, "recursive") { log_print("Recursive Task-in-Task Arguments: OK") }

  log_print("10 Pass")
}
